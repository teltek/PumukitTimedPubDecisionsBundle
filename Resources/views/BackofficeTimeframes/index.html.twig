{% extends '@PumukitNewAdmin/layout.html.twig' %}

{% set palette = ['primary', 'success', 'warning', 'info', 'danger', 'secondary'] %}
{% set statusNames = {0: 'Published', 1: 'Blocked', 2: 'Hidden'} %}
{% set statusLabels = {published: 'Published', unpublished: 'Not published', all: 'All', processing: 'All, including in process'} %}
{% set filters = {tag: tag, status: status} %}
{% set colors = {} %}
{% for code in codes %}
    {% set colors = colors|merge({(code): palette[loop.index0 % palette|length]}) %}
{% endfor %}

{% block body %}
    <link rel="stylesheet" href="{{ asset('@pumukit/timed-pub-decisions/styles/timeline.css') }}">

    <h3 class="cab_body_div">
        <ul class="breadcrumb pmk-margin-bottom-5">
            <li class="breadcrumb-item active">{% trans %}Timed Publishing Decisions Timeframes{% endtrans %}</li>
        </ul>
    </h3>

    <div class="pmk-well" data-controller="timed-pub-decisions--timeline"
         data-timed-pub-decisions--timeline-start-value="{{ start|date('Y-m-d\\TH:i') }}"
         data-timed-pub-decisions--timeline-end-value="{{ end|date('Y-m-d\\TH:i') }}">
        <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
            <form class="d-flex flex-wrap align-items-end gap-2" method="get" action="{{ path('pumukit_newadmin_timeframes_index_default') }}" data-action="change->timed-pub-decisions--timeline#filter">
                <input type="hidden" name="start" value="{{ start|date('Y-m-d') }}">
                <div>
                    <label class="form-label small mb-0" for="tpd-tag">{% trans %}Decision{% endtrans %}</label>
                    <select class="form-select form-select-sm" id="tpd-tag" name="tag">
                        <option value="">{% trans %}All{% endtrans %}</option>
                        {% for code in codes %}
                            <option value="{{ code }}" {{ code == tag ? 'selected' }}>{{ code }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label class="form-label small mb-0" for="tpd-status">{% trans %}Status{% endtrans %}</label>
                    <select class="form-select form-select-sm" id="tpd-status" name="status">
                        {% for value in statuses %}
                            <option value="{{ value }}" {{ value == status ? 'selected' }}>{{ statusLabels[value]|trans }}</option>
                        {% endfor %}
                    </select>
                </div>
                <noscript><button type="submit" class="btn btn-sm btn-pumukit">{% trans %}Filter{% endtrans %}</button></noscript>
            </form>
            <div class="btn-group btn-group-sm ms-md-auto" role="group" aria-label="{% trans %}Period{% endtrans %}">
                <a class="btn btn-outline-secondary" href="{{ path('pumukit_newadmin_timeframes_index_default', filters|merge({start: previous|date('Y-m-d')})) }}" title="{% trans %}Previous{% endtrans %}"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></a>
                <a class="btn btn-outline-secondary" href="{{ path('pumukit_newadmin_timeframes_index_default', filters) }}">{% trans %}Today{% endtrans %}</a>
                <a class="btn btn-outline-secondary" href="{{ path('pumukit_newadmin_timeframes_index_default', filters|merge({start: next|date('Y-m-d')})) }}" title="{% trans %}Next{% endtrans %}"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></a>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-3 small mb-2">
            {% for code in codes %}
                <span><span class="tpd-swatch bg-{{ colors[code] }}"></span> {{ code }}</span>
            {% endfor %}
            <span><span class="tpd-swatch tpd-permanent"></span> {% trans %}Permanent{% endtrans %}</span>
            <span class="text-body-secondary">{{ start|date('d/m/Y') }} – {{ end|date('d/m/Y') }}</span>
        </div>

        {% if rows is empty %}
            <div class="alert alert-info mb-0">{% trans %}There are no temporized decisions in this period.{% endtrans %}</div>
        {% else %}
            <div class="tpd-timeline">
                <div class="tpd-row tpd-header">
                    <div class="tpd-label small text-body-secondary">{% trans %}Video{% endtrans %}</div>
                    <div class="tpd-track">
                        {% for month in months %}
                            <span class="tpd-month" data-timed-pub-decisions--timeline-target="mark" data-date="{{ month|date('Y-m-d\\TH:i') }}">{{ month|date('m/Y') }}</span>
                        {% endfor %}
                        <span class="tpd-today" data-timed-pub-decisions--timeline-target="mark" data-date="{{ today|date('Y-m-d\\TH:i') }}" title="{% trans %}Today{% endtrans %}"></span>
                    </div>
                </div>
                {% for row in rows %}
                    {% set color = colors[row.code] %}
                    <div class="tpd-row">
                        <div class="tpd-label">
                            <a href="{{ path('pumukitnewadmin_mms_shortener', {'id': row.id}) }}" target="_blank" class="text-truncate d-block" title="{{ row.title }}">{{ row.title }}</a>
                            <span class="badge text-bg-{{ color }}">{{ row.code }}</span>
                            <span class="badge text-bg-light border">{{ statusNames[row.status]|default(row.status)|trans }}</span>
                            {% if row.permanent %}
                                <span class="small text-body-secondary">{% trans %}Permanent{% endtrans %}</span>
                            {% else %}
                                <span class="small font-monospace">{{ row.from|replace({'T': ' '}) }} → {{ row.to|replace({'T': ' '}) }}</span>
                                {% if row.applied %}<i class="fa-solid fa-circle-check text-success" title="{{ 'Start applied on %date%'|trans({'%date%': row.applied|replace({'T': ' '})}) }}"></i>{% endif %}
                            {% endif %}
                        </div>
                        <div class="tpd-track">
                            {% if row.permanent %}
                                <span class="tpd-bar tpd-permanent tpd-bar-whole"></span>
                            {% else %}
                                <span class="tpd-bar bg-{{ color }}" data-timed-pub-decisions--timeline-target="bar" data-from="{{ row.from }}" data-to="{{ row.to }}" title="{{ row.from|replace({'T': ' '}) }} → {{ row.to|replace({'T': ' '}) }}"></span>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
