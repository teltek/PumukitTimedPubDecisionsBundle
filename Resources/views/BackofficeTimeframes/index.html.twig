{% extends '@PumukitNewAdmin/layout.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" type="text/css" media="screen" href="{{ asset('/bundles/pumukitnewadmin/css/admin/dashboard.css') }}"/>
    <style>
        #timeframes-chart-wrap { position: relative; height: calc(100vh - 350px); }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="text/javascript" src="{{ asset('/bundles/pumukitnewadmin/vendor/chartjs/chart.umd.min.js') }}"></script>
    <script type="text/javascript" src="{{ asset('/bundles/pumukitnewadmin/vendor/chartjs/chartjs-adapter-date-fns.bundle.min.js') }}"></script>
    <script type="text/javascript" src="{{ asset('/bundles/pumukitnewadmin/vendor/chartjs/chartjs-plugin-zoom.min.js') }}"></script>
{% endblock %}

{% block body %}
    <h1>{% trans %}Timed Publishing Decisions Timeframes{% endtrans %}</h1>

    <div class="well">
        <div class="row">
            <div id="leyenda" class="col-md-3">
                <div style="color: {{ colors['PUDERADIO'] }}; border-top: 3px solid;">Destacados Radio</div>
                <div style="color: {{ colors['PUDETV'] }}; border-top: 3px solid;">Destacados TV</div>
            </div>

            <div id="timeframes-dashboard-select" class="col-md-6">
                <form id="form-destacados" name="form-destacados" method="get" action="#">
                    <div class="col-md-3">
                        <div id="select-destacados" style="float:left;">
                            <div style="white-space: nowrap; font-weight:bold;">&nbsp;Destacados
                                <span style="color:{{ colors['PUDERADIO'] }}">Radio</span> /
                                <span style="color:{{ colors['PUDETV'] }}">TV</span></div>
                            <select name="tags" onchange="this.form.submit();">
                                <option value="">Todos</option>
                                <option value="PUDERADIO" {% if app.session.get('pumukit_timed_pub_decisions.tags') == 'PUDERADIO' %}selected="selected"{% endif %}>
                                    Destacados Radio
                                </option>
                                <option value="PUDETV" {% if app.session.get('pumukit_timed_pub_decisions.tags') == 'PUDETV' %}selected="selected"{% endif %}>
                                    Destacados TV
                                </option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3 col-md-offset-1">
                        <div id="select-estado">
                            <div style="font-weight:bold;">&nbsp;Estado</div>
                            <select name="status" onchange="this.form.submit();">
                                <option value="">Todos</option>
                                <option value="0" {% if app.session.get('pumukit_timed_pub_decisions.status') == '0' %}selected="selected"{% endif %}>
                                    Publicado
                                </option>
                                <option value="1" {% if app.session.get('pumukit_timed_pub_decisions.status') == '1' %}selected="selected"{% endif %}>
                                    No publicado
                                </option>
                                <option value="-1" {% if app.session.get('pumukit_timed_pub_decisions.status') == '-1' %}selected="selected"{% endif %}>
                                    Todos incluidos en proceso
                                </option>
                            </select>
                        </div>
                    </div>
                </form>
            </div>

            <div class="col-md-3 text-right">
                <a href="javascript:void(0);" id="btn-centra-hoy">{% trans %}Center on today{% endtrans %}</a>
            </div>
        </div>
    </div>

    <div class="text-center well">
        <div id="timeframes-chart-wrap">
            <canvas id="timeframes-chart"></canvas>
        </div>
        <noscript>
            {% trans %}This page uses Javascript to show you a Timeline.{% endtrans %}
            {% trans %}Please enable Javascript in your browser to see the full page.{% endtrans %}
        </noscript>
    </div>

    <script type="text/javascript">
        (function () {
            const dataUrl = '{{ path('pumukit_newadmin_timeframes_json') }}' + window.location.search;
            const canvas = document.getElementById('timeframes-chart');
            if (!canvas) {
                return;
            }

            const now = new Date();
            const monthMs = 30 * 24 * 60 * 60 * 1000;
            const initialMin = new Date(now.getTime() - monthMs);
            const initialMax = new Date(now.getTime() + monthMs);

            let chart = null;

            function buildDataset(events) {
                return events.map(function (e, idx) {
                    return {
                        x: [e.start, e.end],
                        y: idx,
                        title: e.title,
                        tag: e.tag,
                        link: e.link,
                        permanent: e.permanent,
                        backgroundColor: e.color,
                        borderColor: e.color,
                    };
                });
            }

            function render(events) {
                const data = buildDataset(events);
                const labels = events.map(function (e) { return e.title; });

                chart = new Chart(canvas.getContext('2d'), {
                    type: 'bar',
                    data: {
                        datasets: [{
                            label: '{{ 'Timeframes'|trans|e('js') }}',
                            data: data,
                            backgroundColor: data.map(function (d) { return d.backgroundColor; }),
                            borderColor: data.map(function (d) { return d.borderColor; }),
                            borderWidth: 1,
                            borderSkipped: false,
                            barPercentage: 0.7,
                        }],
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        indexAxis: 'y',
                        scales: {
                            x: {
                                type: 'time',
                                min: initialMin,
                                max: initialMax,
                                time: { unit: 'day' },
                            },
                            y: {
                                ticks: {
                                    callback: function (value) {
                                        const label = labels[value];
                                        if (!label) return '';
                                        return label.length > 40 ? label.slice(0, 37) + '…' : label;
                                    },
                                    autoSkip: false,
                                },
                            },
                        },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    title: function (items) {
                                        return items[0].raw.title;
                                    },
                                    label: function (ctx) {
                                        if (ctx.raw.permanent) {
                                            return '{{ 'Permanent editorial decision'|trans|e('js') }} · ' + ctx.raw.tag;
                                        }
                                        const start = new Date(ctx.raw.x[0]).toLocaleString();
                                        const end = new Date(ctx.raw.x[1]).toLocaleString();
                                        return start + ' → ' + end + ' · ' + ctx.raw.tag;
                                    },
                                },
                            },
                            zoom: {
                                pan: { enabled: true, mode: 'x' },
                                zoom: {
                                    wheel: { enabled: true },
                                    pinch: { enabled: true },
                                    mode: 'x',
                                },
                            },
                        },
                        onClick: function (evt, elements) {
                            if (!elements.length) return;
                            const el = elements[0];
                            const item = chart.data.datasets[el.datasetIndex].data[el.index];
                            if (item && item.link) {
                                window.open(item.link, '_blank');
                            }
                        },
                    },
                });
            }

            fetch(dataUrl, { credentials: 'same-origin' })
                .then(function (r) { return r.json(); })
                .then(function (payload) {
                    render(payload.events || []);
                })
                .catch(function (err) {
                    canvas.parentNode.innerHTML = '<p class="text-danger">{{ 'Could not load timeline data.'|trans|e('js') }}</p>';
                    console.error(err);
                });

            document.getElementById('btn-centra-hoy').addEventListener('click', function () {
                if (!chart) return;
                const ref = new Date();
                chart.options.scales.x.min = new Date(ref.getTime() - monthMs);
                chart.options.scales.x.max = new Date(ref.getTime() + monthMs);
                chart.update();
            });
        })();
    </script>
{% endblock %}
