{% set temporary = multimediaObject.getProperty('temporized_' ~ tag) == constant('Pumukit\\TimedPubDecisionsBundle\\Services\\TemporizedDecisionService::TEMPORARY') %}
{% set applied = multimediaObject.getProperty('temporized_published_' ~ tag) %}
<div class="row g-2 align-items-end ms-3"
     data-controller="timed-pub-decisions--options"
     data-timed-pub-decisions--options-decision-value="pub_decisions_{{ tag }}"
     data-timed-pub-decisions--options-range-message-value="{{ 'The end must be after the start.'|trans }}">
    <div class="col-auto">
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="optionsTemporized_{{ tag }}" id="optionsTemporizedNo_{{ tag }}" value="-1"
                   {{ not temporary ? 'checked' }} {{ not hasTag ? 'disabled' }}
                   data-timed-pub-decisions--options-target="option" data-action="timed-pub-decisions--options#toggle">
            <label class="form-check-label" for="optionsTemporizedNo_{{ tag }}">{% trans %}Permanent{% endtrans %}</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="optionsTemporized_{{ tag }}" id="optionsTemporized_{{ tag }}" value="1"
                   {{ temporary ? 'checked' }} {{ not hasTag ? 'disabled' }}
                   data-timed-pub-decisions--options-target="option temporary" data-action="timed-pub-decisions--options#toggle">
            <label class="form-check-label" for="optionsTemporized_{{ tag }}">{% trans %}Temporary{% endtrans %}</label>
        </div>
    </div>
    <div class="col-sm-auto">
        <label class="form-label small mb-0" for="temporized_from_{{ tag }}">{% trans %}From{% endtrans %}</label>
        <input type="datetime-local" class="form-control form-control-sm" id="temporized_from_{{ tag }}" name="temporized_from_{{ tag }}[{{ tag }}]" required
               value="{{ multimediaObject.getProperty('temporized_from_' ~ tag) }}" {{ not (hasTag and temporary) ? 'disabled' }}
               data-timed-pub-decisions--options-target="from" data-action="timed-pub-decisions--options#validate">
    </div>
    <div class="col-sm-auto">
        <label class="form-label small mb-0" for="temporized_to_{{ tag }}">{% trans %}To{% endtrans %}</label>
        <input type="datetime-local" class="form-control form-control-sm" id="temporized_to_{{ tag }}" name="temporized_to_{{ tag }}[{{ tag }}]" required
               value="{{ multimediaObject.getProperty('temporized_to_' ~ tag) }}" {{ not (hasTag and temporary) ? 'disabled' }}
               data-timed-pub-decisions--options-target="to" data-action="timed-pub-decisions--options#validate">
    </div>
    {% if temporary and applied %}
        <div class="col-12 form-text mt-1">
            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
            {{ 'The start was applied on %date%: the video is not published again unless the start date is changed.'|trans({'%date%': applied|replace({'T': ' '})}) }}
        </div>
    {% endif %}
</div>
